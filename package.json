{
  "name": "claude-usage-status",
  "displayName": "Claude Usage Status",
  "description": "VS Code status bar usage indicator for Claude Code. Requires https://github.com/realiti4/claude-swap to work.",
  "version": "0.1.0",
  "icon": "icon.png",
  "publisher": "smith89k",
  "repository": {
    "type": "git",
    "url": "https://github.com/smith89k/claude-swap-ide.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeSwap.switchAccount",
        "title": "Claude Swap: Switch Account"
      },
      {
        "command": "claudeSwap.addAccount",
        "title": "Claude Swap: Add Account"
      },
      {
        "command": "claudeSwap.refreshStatus",
        "title": "Claude Swap: Refresh Usage"
      }
    ],
    "configuration": {
      "title": "Claude Swap",
      "properties": {
        "claudeSwap.pollIntervalMinutes": {
          "type": "number",
          "default": 5,
          "description": "How often to poll cswap for usage status (in minutes)."
        },
        "claudeSwap.cswapExecutablePath": {
          "type": "string",
          "default": "cswap",
          "description": "Path to the cswap CLI executable if it is not in your PATH."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "build": "npm run package"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.19.11",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "canvas": "^3.2.3"
  }
}
