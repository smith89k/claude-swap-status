{
  "name": "claude-swap-status",
  "displayName": "Claude Swap Status",
  "description": "See your Claude Code usage in the status bar, and give each Antigravity IDE or VS Code window its own Claude account. Not affiliated with Anthropic.",
  "version": "0.3.0",
  "license": "MIT",
  "icon": "icon.png",
  "publisher": "smith89k",
  "repository": {
    "type": "git",
    "url": "https://github.com/smith89k/claude-swap-status.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeSwap.switchAccount",
        "title": "Switch Account",
        "category": "Claude Swap"
      },
      {
        "command": "claudeSwap.addAccount",
        "title": "Add Account",
        "category": "Claude Swap",
        "icon": "$(add)"
      },
      {
        "command": "claudeSwap.refreshStatus",
        "title": "Refresh Usage",
        "category": "Claude Swap",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeSwap.useInThisWindow",
        "title": "Use Account in This Window",
        "category": "Claude Swap"
      },
      {
        "command": "claudeSwap.useMainLogin",
        "title": "Switch This Window to the Main Account",
        "category": "Claude Swap"
      },
      {
        "command": "claudeSwap.renameAccount",
        "title": "Rename Account",
        "category": "Claude Swap"
      },
      {
        "command": "claudeSwap.removeAccount",
        "title": "Delete Account",
        "category": "Claude Swap"
      },
      {
        "command": "claudeSwap.signInAgain",
        "title": "Sign In Again",
        "category": "Claude Swap"
      },
      {
        "command": "claudeSwap.openPanel",
        "title": "Open Accounts Panel",
        "category": "Claude Swap"
      }
    ],
    "configuration": {
      "title": "Claude Swap",
      "properties": {
        "claudeSwap.pollIntervalMinutes": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "description": "How often to check usage, in minutes. Minimum 0.5."
        },
        "claudeSwap.confirmBeforeReload": {
          "type": "boolean",
          "default": true,
          "description": "Ask before reloading a window to switch its Claude account."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeSwap",
          "title": "Claude Accounts",
          "icon": "media/accounts.svg"
        }
      ]
    },
    "views": {
      "claudeSwap": [
        {
          "type": "webview",
          "id": "claudeSwap.accounts",
          "name": "Accounts"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "claudeSwap.addAccount",
          "when": "view == claudeSwap.accounts",
          "group": "navigation@1"
        },
        {
          "command": "claudeSwap.refreshStatus",
          "when": "view == claudeSwap.accounts",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeSwap.signInAgain",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "npm run package -- --watch",
    "package": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "build": "npm run package",
    "test": "node scripts/build-tests.mjs && node --test \"out-test/*.test.js\"",
    "test:launch": "npm run build && node scripts/run-launch-test.mjs"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "canvas": "^3.2.3",
    "esbuild": "^0.19.11",
    "typescript": "^5.3.3"
  }
}
